---
import Button from "../components/ui/Button.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroBanner from "@components/HeroBanner.astro";
import CardA from "@components/Card-A.astro";
import CardB from "@components/Card-B.astro";
import CardC from "@components/Card-C.astro";

import myImage from "@assets/HomeHero.png";
import SectionB from "../components/structure/SectionB.astro";
import SectionA from "../components/structure/SectionA.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import Typography from "@ui/Typography.astro";

const stats = [
  {
    value: "1-on-1",
    description:
      "Every student gets a dedicated tutor and a study plan built around their specific gaps — not a generic course.",
  },
  {
    value: "5",
    description:
      "Distinct programs — from first-time takers to the MBE to early bar prep before graduation.",
  },
  {
    value: "4×",
    description:
      "Law school partners across Florida. Agape's reach spans Jacksonville and beyond, all delivered remotely.",
  },
];

import ArrowRightIcon from "~icons/lucide/arrow-right";
import IconPencil from "~icons/lucide/pencil";
import IconRotateCw from "~icons/lucide/rotate-cw";
import IconGlobe from "~icons/lucide/globe";
import IconBook from "~icons/lucide/book";
import ListItemA from "@components/ListItemA.astro";
import Scroller from "@components/ui/Scroller.astro";

export const services = [
  {
    icon: IconPencil,
    title: "First-Time Bar Takers",
    description:
      "Pass the first time with a study plan built around your strengths and gaps — not a generic video course.",
    href: "/services/first-time-bar-takers",
  },
  {
    icon: IconRotateCw,
    title: "Repeat Bar Takers",
    description:
      "A focused, diagnostic approach for graduates returning after a setback — find what failed and fix it.",
    href: "/services/repeat-bar-takers",
  },
  {
    icon: IconGlobe,
    title: "MBE Prep",
    description:
      "Targeted Multistate Bar Exam tutoring across all seven subjects for any jurisdiction.",
    href: "/services/mbe-prep",
  },
  {
    icon: IconBook,
    title: "Law School & Early Bar Prep",
    description:
      "Build analytical skills during school and start bar prep before you graduate — through our Bar Prep Academy.",
    href: "/services/law-school-early-bar-prep",
  },
] as const;

const features = [
  {
    title: "Personalized 1-on-1 Tutoring",
    description:
      "We diagnose your gaps and rebuild your foundation subject by subject — no cookie-cutter curriculum.",
  },
  {
    title: "A Holistic Approach",
    description:
      "Spiritual, mental, emotional, and academic support — because every part of you shows up on exam day.",
  },
  {
    title: "Faith-Centered Community",
    description:
      "Weekly team prayer, mentorship, and a family that walks with you from first session to exam day.",
  },
  {
    title: "Tutors Who've Been There",
    description:
      "Practicing attorneys who passed the bar and now coach others through it from the inside out.",
  },
];

const steps = [
  {
    title: "Apply or Schedule a Consultation",
    description:
      "Tell us about your goals and exam timeline. No pressure — it's a conversation about how we can help.",
  },
  {
    title: "Get Matched and Get Your Plan",
    description:
      "We diagnose your gaps and build a study plan around your specific weaknesses, learning style, and exam date.",
  },
  {
    title: "Begin Tutoring and Weekly Check-ins",
    description:
      "1-on-1 sessions, practice essays, MBE drills, and team prayer — every week, all the way to exam day.",
  },
];

const testimonials = [
  {
    quote:
      "Agape didn't just prepare me for the bar exam they prepared me for the journey. The one-on-one attention and the prayer support made all the difference when the pressure was highest.",
    name: "Justin Bell",
    credential: "Passed February 2022, first attempt",
    rating: 5,
  },
  {
    quote:
      "After failing twice on my own, I found Agape. My tutor identified exactly where I was losing points and built a plan around those gaps. I passed the July administration and I am so grateful.",
    name: "Ashley Palmer",
    credential: "Repeat taker — passed July 2023",
    rating: 5,
  },
  {
    quote:
      "The holistic approach is real. I wasn't just getting MBE drills — I was getting accountability, encouragement, and a community that believed in me. That's what got me across the finish line.",
    name: "Tiffany Young",
    credential: "Passed February 2023, Florida Bar",
    rating: 5,
  },
];
---

<BaseLayout title="Agape Christian Bar Prep">
  <HeroBanner
    eyebrow="Christian Bar Exam Prep"
    title="Christian Bar Exam Prep Built Around You"
    body="One-on-one tutoring and a holistic study plan — spiritually,
    mentally, and academically — for first-time takers, repeat
    takers, and the MBE."
    image={myImage}
    badge={{
      eyebrow: "Now Enrolling",
      text: "Free consultation for July bar takers",
      linkText: "Schedule Now",
      href: "/consultation",
    }}
  >
    <Fragment slot="actions" }>
      <Button>Apply Now</Button>
      <Button variant="outline">Free Consultation</Button>
    </Fragment>
    <p class="trust">
      Trusted by graduates from Florida Coastal, Florida A&M, Barry, and Ave
      Maria · Jacksonville, FL
    </p>
  </HeroBanner>
  <SectionB sectionId="equipping-attorneys">
    <SectionHeading
      eyebrow="Equipping Attorneys"
      sectionId="equipping-attorneys"
      heading="Equipping attorneys to
        pass — and to grow."
    />
    <div class="triplex">
      {
        stats.map((stat) => (
          <CardA value={stat.value} description={stat.description} />
        ))
      }
    </div>
  </SectionB>
  <SectionB sectionId="Services" background="off-white">
    <SectionHeading
      eyebrow="Services"
      sectionId="Services"
      heading="How We Help"
      body="Whether you're sitting for the bar for the first time, returning after a setback, or still in law school, Agape meets you where you are."
    />
    <div class="quad">
      {
        services.map((service) => {
          const Icon = service.icon;
          return (
            <CardB
              title={service.title}
              description={service.description}
              href={service.href}
            >
              <Icon slot="icon" />
            </CardB>
          );
        })
      }
    </div>
  </SectionB>
  <SectionA sectionId="theAgapeWay" dark>
    <div class="flow" style="--flow-space: var(--spacing-lg);">
      <SectionHeading
        eyebrow="Our Approach"
        sectionId="theAgapeWay"
        heading="The Agape Way"
        body="Bar prep tests more than legal knowledge — it tests your
stamina, confidence, and resolve. Our four-part approach
addresses the whole person."
      />
      <div>
        <ul class="flow" style="--flow-space: var(--spacing-md);">
          {
            features.map((feature, i) => (
              <ListItemA
                number={String(i + 1).padStart(2, "0")}
                title={feature.title}
                description={feature.description}
              />
            ))
          }
        </ul>
      </div>
      <Button variant="accent">
        Learn more <span class="visually-hidden">about our approach</span>
        <ArrowRightIcon />
      </Button>
    </div>

    <div class="flow">
      <CardA
        value="100%"
        description="Custom study plans — every student receives a unique plan built around their exam date and specific weak areas.
"
      />

      <CardA
        value="4-part"
        description="Holistic support model — spiritual, mental, emotional, and academic. No other bar prep does this."
      />
    </div>
  </SectionA>
  <SectionB sectionId="testimonials">
    <SectionHeading
      eyebrow="Student Stories"
      sectionId="testimonials"
      heading="Hear from Agape graduates"
    />
    <Scroller client:load>
      {
        testimonials.map((t) => (
          <li>
            <CardC
              name={t.name}
              credential={t.credential}
              quote={t.quote}
              rating={t.rating}
            />
          </li>
        ))
      }
    </Scroller>
  </SectionB>
  <SectionA sectionId="getting-started" background="off-white">
    <div class="flow" style="--flow-space: var(--spacing-lg);">
      <SectionHeading
        eyebrow="Getting Started"
        sectionId="getting-started"
        heading="How to Get Started"
        body="Most people don't apply because they don't know what happens next. Here's the path from first contact to exam day."
      />
      <Button variant="accent">Apply Now</Button>
    </div>

    <ul class="flow" style="--flow-space: var(--spacing-md);">
      {
        steps.map((step, i) => (
          <ListItemA
            number={String(i + 1).padStart(2, "0")}
            title={step.title}
            description={step.description}
          />
        ))
      }
    </ul>
  </SectionA>

  <SectionA sectionId="about">
    <div class="flow" style="--flow-space: var(--spacing-lg);">
      <SectionHeading
        eyebrow="About"
        sectionId="about"
        heading="About Agape"
        body="Agape Christian Bar Prep was founded in Jacksonville, Florida with one mission: to equip law graduates to pass the bar exam — and to grow through the process. Our founder is a practicing attorney who experienced firsthand how much the bar exam tests more than legal knowledge."
      />
      <Typography variant="body">
        We believe that with the right one-on-one support, a personalized plan,
        and a community rooted in faith and encouragement, every qualified law
        graduate can pass. We've helped graduates from Florida Coastal, Florida
        A&M, Barry, Ave Maria, and beyond.
      </Typography>
      <Button href="/about">Meet the Team</Button>
    </div>

    {/* Placeholder — swap for <Image /> once the real asset lands */}
    <div class="about-image" aria-hidden="true"></div>
  </SectionA>
</BaseLayout>

<style>
  .trust {
    font-size: var(--font-size-sm);
    max-width: 60ch;
    text-wrap: balance;
    color: var(--text-muted);
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .about-image {
    aspect-ratio: 1 / 1;
    inline-size: 100%;
    background: var(--clr-gray-400);
  }

  ul:not(.steps) li:not(:last-child) {
    padding-bottom: var(--spacing-md);
    border-bottom: 1px solid var(--border-muted);
  }
</style>
