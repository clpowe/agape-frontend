const steps = [
  {
    title: "Reach Out",
    detail:
      "Call us or schedule a free consultation. Tell us your exam date, your jurisdiction, your last score — and what you think went wrong.",
  },
  {
    title: "Pick a Program (or Stack)",
    detail:
      "We'll recommend the right starting point — Bar Prep 101 Plus as your primary program, plus Crash Course, Essay Clinic, MPT Workshops, or Private Tutoring where it counts.",
  },
  {
    title: "Show Up & Do the Work",
    detail:
      "We bring the structure, the feedback, and the accountability. You bring the effort. Together that's how bar exams get passed.",
  },
];
---

<BaseLayout title="Repeat Bar Takers | Agape Christian Bar Prep">
  <HeroBanner
    eyebrow="Repeat Bar Takers · Services"
    title="This time, pass it."
    body="Structure, strategy, accountability, and the kind of personalized feedback a commercial course can't give you. Built specifically for repeat takers ready to close the gap between knowing the law and performing under exam conditions."
    image={heroImage}
    imageAlt="A repeat bar taker studying with a personalized plan"
    badge={{
      eyebrow: "Now Enrolling",
      text: "Bar Prep 101 Plus is enrolling repeat takers now",
      linkText: "See the Program",
      href: "#thePrograms",
    }}
  >
    <Fragment slot="actions">
      <Button href="/apply" variant="accent">Apply Now</Button>
      <Button href="tel:+19042342853" variant="outline">
        Call 904-234-2853
      </Button>
    </Fragment>
  </HeroBanner>

  <SectionA sectionId="repeatOverview" width="default" background="white">
    <div class="flow">
      <SectionHeading
        eyebrow="Overview"
        sectionId="repeatOverview"
        heading="A different approach for a different attempt."
      />
    </div>

    <div class="flow contain">
      <Typography tag="blockquote" variant="blockquote">
        Doing the same thing a second time and expecting a different result
        won't get you to a passing score. Repeat takers need diagnosis,
        structure, and feedback — not another set of lectures.
      </Typography>
      <Typography tag="p" variant="body">
        Our repeat-taker programs target the things that decide bar exam
        outcomes: writing, timing, recall under pressure, and the discipline of
        a personalized plan. Stack the ones that fit your weak spots, and we'll
        walk through it with you.
      </Typography>
    </div>
  </SectionA>

  <SectionB sectionId="thePrograms" background="off-white">
    <SectionHeading
      eyebrow="The Programs"
      sectionId="thePrograms"
      heading="Five programs. Built to work together."
      body="Rebuild your study skills in the Crash Course. Sharpen writing in the Essay Clinic. Take on Bar Prep 101 Plus as your full repeat-taker program. Add the MPT Workshops for UBE jurisdictions, and use Private Tutoring whenever a specific weakness needs focused work."
    />
    <div class="courses flow">
      {
        programs.map((program) => (
          <Course
            eyebrow={program.eyebrow}
            title={program.title}
            description={program.description}
            theme={program.theme as "light" | "dark"}
            price={program.price}
            panels={program.panels as Panel[]}
            footnote={program.footnote}
            cta={program.cta}
          />
        ))
      }
    </div>
  </SectionB>

  <SectionA sectionId="howWeWork" width="default" background="off-white">
    <SectionHeading
      eyebrow="How We Work"
      sectionId="howWeWork"
      heading="From diagnosis to passing-score day."
      body="Repeat-taker outcomes change when the plan changes. Tell us what happened last time, we'll diagnose what to do differently, and we'll walk through it with you."
    />
    <ListA border={true} space="tight">
      {
        steps.map((step, i) => (
          <ListItemA
            number={String(i + 1)}
            numSize="2xl"
            title={step.title}
            description={step.detail}
          />
        ))
      }
    </ListA>
  </SectionA>

  <CTA
    sectionId="cta"
    heading="Apply Now"
    body="Click here to join the Agape family. We'd love to talk through your goals and help you pick the right starting point."
  />
</BaseLayout>

<style>
  .courses {
    --flow-space: var(--spacing-3xl);
  }
</style>
