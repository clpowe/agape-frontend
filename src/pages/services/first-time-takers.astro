---
import BaseLayout from "@layouts/BaseLayout.astro";

import HeroBanner from "@components/HeroBanner.astro";

import heroImage from "@assets/studentsInthelibrary.jpg";
import SectionA from "@components/structure/SectionA.astro";
import SectionB from "@components/structure/SectionB.astro";
import SectionHeading from "@ui/SectionHeading.astro";
import Typography from "@ui/Typography.astro";
import Button from "@ui/Button.astro";
import ListA from "@ui/ListA.astro";
import ListItemA from "@ui/list-items/ListItemA.astro";
import CTA from "@components/CTA.astro";
import Course, { type Panel } from "@components/Course.astro";

export const programs = [
  {
    slug: "bar-study-skills-crash-course",
    eyebrow: "Five-Week Course",
    title: "Bar Study Skills Crash Course",
    description:
      "A five-week course that equips students with the essential learning skills and strategies needed to prepare effectively for — and pass — the bar exam. Strengthening these foundations before the intensive prep period begins means students enter bar prep with greater confidence, clarity, and readiness.",
    theme: "light",
    price: {
      label: "Cost",
      amount: "$995",
      unit: "Per student",
      secondary: null,
    },
    panels: [
      {
        heading: "Throughout the course, students will learn",
        type: "numbered",
        items: [
          {
            title:
              "How to develop a big-picture framework for each bar-tested subject.",
          },
          {
            title:
              "How to take effective notes during lectures to fill in and refine their frameworks.",
          },
          {
            title:
              "How to use practice questions to identify voids and gaps in their knowledge and understanding.",
          },
          {
            title:
              "How to fill in those gaps strategically to strengthen both comprehension and application.",
          },
        ],
      },
      {
        heading: "Format & Schedule",
        type: "specs",
        items: [
          { label: "Format", value: "90-minute classes, twice weekly" },
          { label: "Class size", value: "Sections of 7–10 students" },
          {
            label: "Weekly time",
            value: "3 hrs class · 10–15 hrs study & homework",
          },
          { label: "July takers", value: "Mid-March – Late April" },
          { label: "February takers", value: "Mid-October – Late November" },
          {
            label: "Commitment",
            value:
              "Signed agreement to attend all classes and complete all assignments",
          },
        ],
      },
    ],
    footnote:
      "Once students demonstrate mastery of the learning cycle, they're placed on an early-start learning plan — a real head start on bar exam preparation.",
    cta: { label: "Apply / Reserve a Seat", href: "/apply" },
  },

  {
    slug: "essay-writing-clinic",
    eyebrow: "Writing Workshop",
    title: "Essay Writing Clinic",
    description:
      "Develop and strengthen the analytical and writing skills necessary to succeed on law school exams, the bar exam, and in the practice of law. Learn to outline and write essays that are clear, concise, and well-reasoned.",
    theme: "light",
    price: {
      label: "Cost",
      amount: "$1,095",
      unit: "Full clinic",
      secondary: null,
    },
    panels: [
      {
        heading: "Key skills taught",
        type: "numbered",
        items: [
          { title: "Identifying and articulating legal issues in dispute." },
          {
            title:
              "Applying relevant facts to the appropriate rules of law to reach logical conclusions.",
          },
          { title: "Writing clear and concise essays." },
        ],
      },
      {
        heading: "What's included",
        type: "checks",
        items: [
          {
            title: "Eight-hour interactive writing workshop",
            detail:
              "Live, hands-on instruction on outlining and essay structure.",
          },
          {
            title: "Two graded essays",
            detail: "Personalized, constructive feedback on each one.",
          },
          {
            title: "Two 1-hour private tutoring sessions",
            detail:
              "Focused on improving your specific analytical and writing gaps.",
          },
        ],
      },
    ],
    footnote:
      "Strong writing is the single highest-leverage skill on the bar — and the area most first-time takers underestimate.",
    cta: { label: "Apply / Enroll", href: "/apply" },
  },

  {
    slug: "bar-prep-101",
    eyebrow: "Flagship · Supplemental Program",
    title: "Bar Prep 101",
    description:
      "Designed specifically for first-time takers already enrolled in a commercial bar review course who need additional support, guidance, strategy, accountability, and personalized feedback. We focus on the areas traditional courses overlook — writing, feedback, and practical application — so you walk into exam day with real confidence.",
    theme: "light",
    price: {
      label: "Cost",
      amount: "$2,995",
      unit: "Florida & UBE",
      secondary: null,
    },
    panels: [
      {
        heading: "Program features",
        type: "numbered",
        items: [
          {
            title: "Writing Clinics",
            detail:
              "Hands-on instruction for writing high-scoring essays and MPTs (UBE only). Interactive exercises to sharpen writing and build confidence.",
          },
          {
            title: "Graded Writing Assessments",
            detail:
              "Personalized, detailed feedback on seven essays and three MPTs (UBE only).",
          },
          {
            title: "Small Group Tutoring · 10 Sessions",
            detail:
              "Targeted review of heavily tested subtopics — Individual Rights in Constitutional Law, Jurisdiction & Venue in Civil Procedure, Mortgages in Property, and more.",
          },
          {
            title: "Weekly IREAC Exercises",
            detail:
              "Practice identifying issues, reasoning through rules, and writing concise analysis to strengthen MBE and essay performance.",
          },
        ],
      },
      {
        heading: "Also included",
        type: "numbered",
        items: [
          {
            title: "Rule Drilling Sessions",
            detail:
              "High-intensity recall drills on the most frequently tested rules, sharpening memory and quick recall under pressure.",
          },
          {
            title: "Essay Boot Camp",
            detail:
              "In the two weeks before the exam, students complete timed essays each weekday morning, followed by a live tutor review.",
