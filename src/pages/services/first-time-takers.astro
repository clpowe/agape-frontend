const steps = [
  {
    title: "Reach Out",
    detail:
      "Call us or schedule a free consultation. Tell us your exam date, your jurisdiction, and where you're feeling stuck.",
  },
  {
    title: "Pick a Program (or Stack)",
    detail:
      "We'll recommend the right starting point based on your timeline — Crash Course, Essay Clinic, Bar Prep 101, Private Tutoring, or a combination.",
  },
  {
    title: "Show Up & Do the Work",
    detail:
      "We bring the structure, the feedback, and the accountability. You bring the effort. Together that's how bar exams get passed.",
  },
];
---

<BaseLayout title="First-Time Bar Takers | Agape Christian Bar Prep">
  <HeroBanner
    eyebrow="First-Time Bar Takers · Services"
    title="Pass the bar the first time."
    body="Skills-based courses, supplemental coaching, and personalized feedback — built to bridge the gap between law school and the way the bar exam actually tests you."
    image={heroImage}
    imageAlt="First-time bar takers studying in the library"
    badge={{
      eyebrow: "Now Enrolling",
      text: "Bar Prep 101 for the July & February exams",
      linkText: "See the Program",
      href: "#thePrograms",
    }}
  >
    <Fragment slot="actions">
      <Button href="/apply" variant="accent">Apply Now</Button>
      <Button href="tel:+19042342853" variant="outline">
        Call 904-234-2853
      </Button>
    </Fragment>
  </HeroBanner>

  <SectionA sectionId="ftOverview" width="default" background="white">
    <div class="flow">
      <SectionHeading
        eyebrow="Overview"
        sectionId="ftOverview"
        heading="A complete path through your first bar exam — skills, structure, and someone in your corner."
      />
    </div>

    <div class="flow contain">
      <Typography tag="blockquote" variant="blockquote">
        Law school teaches theory, analysis, and the case method. The bar exam
        asks for rapid recall of black-letter law and formulaic application
        under timed conditions. That gap is where most first-time takers
        struggle.
      </Typography>
      <Typography tag="p" variant="body">
        Our first-time taker programs are built to close that gap. Some students
        start months before bar prep begins; some layer our support on top of a
        commercial course; some just need targeted hours with a tutor. Pick what
        fits — or stack what you need.
      </Typography>
    </div>
  </SectionA>

  <SectionB sectionId="thePrograms" background="off-white">
    <SectionHeading
      eyebrow="The Programs"
      sectionId="thePrograms"
      heading="Four programs. Built to work together."
      body="Start with the Crash Course to build the foundation. Sharpen your writing in the Clinic. Enroll in Bar Prep 101 as the supplemental layer on top of your commercial course. Add Private Tutoring whenever a specific weakness needs focused work."
    />
    <div class="courses flow">
      {
        programs.map((program) => (
          <Course
            eyebrow={program.eyebrow}
            title={program.title}
            description={program.description}
            theme={program.theme as "light" | "dark"}
            price={program.price}
            panels={program.panels as Panel[]}
            footnote={program.footnote}
            cta={program.cta}
          />
        ))
      }
    </div>
  </SectionB>

  <SectionA sectionId="howWeWork" width="default" background="off-white">
    <SectionHeading
      eyebrow="How We Work"
      sectionId="howWeWork"
      heading="From first call to passing-score day."
      body="Whichever program you choose, the path looks the same. Tell us where you are, we'll build the plan, and we'll walk with you through it — all the way to the exam."
    />
    <ListA border={true} space="tight">
      {
        steps.map((step, i) => (
          <ListItemA
            number={String(i + 1)}
            numSize="2xl"
            title={step.title}
            description={step.detail}
          />
        ))
      }
    </ListA>
  </SectionA>

  <CTA
    sectionId="cta"
    heading="Apply Now"
    body="Click here to join the Agape family. We'd love to talk through your goals and help you pick the right starting point."
  />
</BaseLayout>

<style>
  .courses {
    --flow-space: var(--spacing-3xl);
  }
</style>
