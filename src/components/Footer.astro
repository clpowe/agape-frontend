---
import Logo from "@assets/agapelogoInverted.svg";
import { footerNavigation, serviceNavigation } from "@/data/navigation";

const socialNavigation = [
  { label: "Facebook", href: "https://facebook.com/envisioncs" },
  { label: "LinkedIn", href: "https://linkedin.com/company/envisioncs" },
  { label: "Instagram", href: "https://instagram.com/envisioncs" },
];
---

<footer>
  <div class="container footer-wrapper">
    <a href="/" class="logo-box">
      <Logo class="logo" />
      <div>
        <p class="agape">Agape Christian</p>
        <p class="bar">Bar Prep & Training</p>
      </div>
    </a>

    <div class="footer-columns">
      <section class="col">
        <h4 class="heading">Contact</h4>
        <div class="seperator"></div>
        <address>
          <div>
            P.O. Box 26586<br />
            Jacksonville, FL 32226
          </div>
          <a class="footer-link" href="tel:+19042342853">1-904-234-2853</a>
          <a class="footer-link" href="mailto:agapechristianbarprep@gmail.com"
            >agapechristianbarprep@gmail.com</a
          >
        </address>
      </section>

      <nav aria-label="footer" class="col">
        <h4 class="heading">Navigate</h4>
        <div class="seperator"></div>
        <ul>
          {
            footerNavigation.map(({ label, href }) => (
              <li>
                <a class="footer-link" href={href}>
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="services" class="col">
        <h4 class="heading">Services</h4>
        <div class="seperator"></div>
        <ul>
          {
            serviceNavigation.map(({ label, href }) => (
              <li>
                <a class="footer-link" href={href}>
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="social" class="col">
        <h4 class="heading">Follow Us</h4>
        <div class="seperator"></div>
        <ul>
          {
            socialNavigation.map(({ label, href }) => (
              <li>
                <a
                  class="footer-link"
                  href={href}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {label}
                  <span class="visually-hidden">(opens in a new tab)</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div class="footer-bottom">
      <p class="copyright">
        &copy; {new Date().getFullYear()} Agape Christian Bar Prep. All rights reserved.
      </p>
      <a class="footer-link" href="/contact">Contact Us</a>
    </div>
  </div>
</footer>

<style>
  footer {
    background-color: var(--clr-gray-950);
    color: var(--text-inverted-strong);
    padding-top: var(--spacing-4xl);
    padding-bottom: var(--spacing-xl);
    font-family: var(--ff-body);
  }
  .footer-wrapper {
    display: grid;
    gap: var(--spacing-3xl);
  }
  .seperator {
    height: 1px;
    background-color: var(--border-inverted-muted);
  }

  .footer-columns {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-xl);

    @media (width > 500px) {
      grid-template-columns: 1fr 1fr;
      gap: var(--spacing-3xl) var(--spacing-2xl);
    }

    @media (width > 900px) {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--spacing-2xl);
    }
  }

  .col {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);

    ul {
      all: unset;
      list-style: none;
      display: flex;
      flex-direction: column;
      margin-top: var(--spacing-xs);
    }
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
    margin-top: var(--spacing-xl);
  }

  .heading {
    font-size: var(--font-size-md);
    font-family: var(--ff-body);
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--clr-yellow-500);
  }

  address {
    all: unset;
    font-size: var(--font-size-sm);
    color: var(--text-inverted-muted);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
    margin-top: var(--spacing-xs);
  }

  li {
    min-height: 32px;
    display: flex;
    align-items: center;
  }
  .footer-link {
    unset: all;
    text-decoration: none;

    font-size: var(--font-size-sm);
    color: var(--text-inverted-muted);

    &:hover {
      color: var(--text-inverted-strong);
    }
  }

  .logo-box {
    all: unset;
    cursor: pointer;
    display: flex;
    gap: var(--spacing-xs);
    text-decoration: none;

    .logo {
      height: 55px;
    }

    .agape {
      font-family: var(--ff-heading);
      font-size: var(--font-size-lg);
      font-weight: 600;
    }

    .bar {
      font-size: var(--font-size-sm);
      text-transform: uppercase;
      font-weight: 400;
      color: var(--text-muted);
    }
  }

  .copyright {
    font-size: var(--font-size-sm);
    color: var(--text-inverted-muted);
  }
</style>
