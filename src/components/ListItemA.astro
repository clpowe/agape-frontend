---
import Typography from "@ui/Typography.astro";

interface Props {
  number?: string;
  title?: string;
  description: string;
}

const { number, title, description } = Astro.props;
---

<li>
  <div class="item">
    {number ? <p class="number">{number}</p> : <div class="dot" />}
    <div class="content flow">
      {title && <h3>{title}</h3>}
      <Typography variant="body">{description}</Typography>
    </div>
  </div>
</li>

<style>
  .item {
    display: grid;
    grid-template-columns: min-content auto;
    gap: var(--spacing-xl);
  }
  .number {
    text-align: center;
    color: var(--text-accent);
    line-height: 0.5;
    font-family: var(--ff-heading);
    font-weight: 600;
    font-size: var(--font-size-6xl);
  }
  .dot {
    height: 0.75rem;
    width: 0.75rem;
    border-radius: 999999rem;
    background-color: var(--clr-red-500);
    margin-top: var(--spacing-2xs);
  }
  h3 {
    font-family: var(--ff-heading);
    font-size: var(--font-size-xl);
    line-height: 1;
  }
  .content {
    --flow-space: var(--spacing-md);
  }
</style>
