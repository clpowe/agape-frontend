---
import Typography from "@ui/Typography.astro";

interface Props {
  number: string;
  title: string;
  description: string;
}

const { number, title, description } = Astro.props;
---

<li>
  <div class="item">
    <p class="number">{number}</p>
    <div class="content flow">
      <h3>{title}</h3>
      <Typography variant="body">{description}</Typography>
    </div>
  </div>
</li>

<style>
  .item {
    display: grid;
    grid-template-columns: auto auto;
    gap: var(--spacing-xl);
  }
  .number {
    text-align: center;
    color: var(--text-accent);
    line-height: 0.5;
    font-family: var(--ff-heading);
    font-weight: 600;
    font-size: var(--font-size-6xl);
  }
  h3 {
    font-family: var(--ff-heading);
    font-size: var(--font-size-xl);
    line-height: 1;
  }
  .content {
    --flow-space: var(--spacing-md);
  }
</style>
