---
import Button from "@ui/Button.astro";
import MobileNav from "./MobileNav.astro";
import { headerNavigation } from "@/data/navigation";
---

<header class="site-header">
  <div class="container" data-width="wide">
    <div class="site-header_inner">
      <a href="/" class="logo-box">
        {/*<Logo class="logo" />*/}
        <div>
          <p class="agape">Agape Christian</p>
          <p class="bar">Bar Prep & Training</p>
        </div>
      </a>

      <MobileNav />
      <nav class="primary-navigation">
        <ul>
          {
            headerNavigation.map(({ label, href, kind }) => (
              <li>
                {kind === "button" ? (
                  <Button as="a" variant="primary" href={href}>
                    {label}
                  </Button>
                ) : (
                  <a
                    class={kind === "phone" ? "phone" : "nav-link"}
                    href={href}
                  >
                    {label}
                  </a>
                )}
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100000;
    padding-block: var(--spacing-xl);
    background: var(--clr-off-white);
    border-bottom: 1px solid var(--border-bold);
  }
  .site-header_inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .primary-navigation {
    ul {
      display: flex;
      list-style: none;
      gap: var(--spacing-2xl);
      align-items: center;
      padding: 0;
    }

    .nav-link {
      unset: all;
      text-decoration: none;
      cursor: pointer;
      font-size: var(--font-size-md);
      color: var(--text-strong);
      font-weight: 500;

      &:hover {
        color: var(--clr-red-500);
      }
    }

    .phone {
      color: var(--clr-red-500);
    }

    @media (width < 881px) {
      display: none;
    }
  }

  .logo-box {
    all: unset;
    cursor: pointer;
    display: grid;
    grid-template-columns: auto auto;
    gap: var(--spacing-xs);
    text-decoration: none;

    .logo {
      unset: all;
      height: 55px;
    }

    .agape {
      font-family: var(--ff-heading);
      font-size: var(--font-size-xl);
      letter-spacing: 3%;
      font-weight: 600;
    }

    .bar {
      font-size: var(--font-size-sm);
      text-transform: uppercase;
      font-weight: 400;
      color: var(--text-muted);
    }
  }
</style>
