---
interface Props {
  sectionId?: string;
  background?: "white" | "off-white";
  dark?: boolean;
  width?: "default" | "narrow" | "wide";
  class?: string;
}

const {
  sectionId,
  background = "white",
  dark = false,
  width = "default",
  class: className,
} = Astro.props;

const headingId = `${sectionId}-heading`;
---

<section
  id={sectionId}
  aria-labelledby={headingId}
  data-background={background}
  class:list={[{ dark }, className]}
>
  <div class="container section-a" data-width={width}>
    <slot />
  </div>
</section>

<style>
  section {
    background-color: var(--clr-white);
    color: var(--text-strong);
    padding-inline: var(--spacing-md);
    padding-block: clamp(var(--spacing-4xl), 10vh + 1rem, var(--spacing-6xl));

    &[data-background="off-white"] {
      background-color: var(--clr-off-white);
    }

    &.dark {
      background-color: var(--clr-gray-950);
    }
  }

  .section-a {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-4xl);

    @media (width > 800px) {
      grid-template-columns: 1fr 1fr;
      gap: var(--spacing-4xl);
    }
  }
</style>
