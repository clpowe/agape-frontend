---
import { Image } from "astro:assets";
import Typography from "./ui/Typography.astro";
import ArrowRightIcon from "~icons/lucide/arrow-right";

interface Badge {
  eyebrow?: string;
  text: string;
  linkText?: string;
  href: string;
}

interface RemoteImage {
  src: string;
  width: number;
  height: number;
}

interface Props {
  eyebrow?: string;
  title: string;
  body?: string;
  image?: ImageMetadata | RemoteImage;
  imageAlt?: string;
  badge?: Badge;
}

// data arrays
const partners = ["University of Florida", "Stetson University"];

const { eyebrow, title, body, image, imageAlt = "", badge } = Astro.props;
---

<section>
  <div class="hero-left">
    <div class="content flow">
      <div class="heading-wrapper flow">
        <Typography tag="h1" variant="eyebrow">{eyebrow}</Typography>
        <h2 class="title">{title}</h2>
      </div>
      <Typography variant="body">
        {body}
      </Typography>
      <div class="actions">
        <slot name="actions" />
      </div>
    </div>
  </div>
  <div class="hero-right">
    {
      image && (
        <Image
          class="main-image"
          src={"format" in image ? image : image.src}
          width={image.width}
          height={image.height}
          alt={imageAlt}
        />
      )
    }
  </div>

  <div class="partners">
    <span>
      <p class="partners-label" id="partners-label">Partnered with:</p>
      <ul class="partners-list" role="list" aria-labelledby="partners-label">
        {partners.map((partner) => <li>{partner}</li>)}
      </ul>
    </span>
  </div>
</section>

<style>
  section {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-rows: auto;
    background-color: var(--clr-off-white);
    height: 85dvh;

    .hero-left {
      display: flex;
      max-width: calc(800px + calc(2 * var(--spacing-sm)));
      place-self: start;
      height: stretch;
      padding: var(--spacing-md);
      padding-block: var(--spacing-4xl);
    }

    .hero-right {
      position: relative;
      max-width: calc(800px + calc(2 * var(--spacing-sm)));
      height: 100%;
    }

    @media (width > 800px) {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: 1fr auto;

      .hero-left {
        align-self: center;
        justify-self: end;
        padding: var(--spacing-md);
      }
    }
  }

  .content {
    margin-top: auto;
    padding-bottom: unset;

    .heading-wrapper {
      --flow-space: var(--spacing-2xs);
    }

    @media (width > 800px) {
      margin-top: auto;
      padding-bottom: var(--spacing-6xl);
    }
  }

  .title {
    font-size: var(--font-size-4xl);
    font-weight: 400;

    @media (width > 800px) {
      font-size: var(--font-size-5xl);
    }
  }

  .actions {
    display: flex;
    gap: var(--spacing-md);
  }

  .main-image {
    height: 100%;
    width: 100%;
    object-fit: cover;
  }

  .badge {
    all: unset;
    --flow-space: var(--spacing-xs);

    max-width: 240px;
    background: var(--clr-yellow-500);
    position: absolute;
    bottom: var(--spacing-xl);
    padding: var(--spacing-xl);
    z-index: 1;

    .main {
      font-family: var(--ff-heading);
      font-size: var(--font-size-xl);
      line-height: 1.1;
    }

    .cta {
      display: flex;
      align-items: center;
      gap: var(--spacing-2xs);
    }
  }

  .partners {
    grid-column: 1/-1;
    padding-block: var(--spacing-md);
    border-block: 1px solid var(--border-muted);
    background: var(--clr-white);
    align-content: center;

    span {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      margin-inline: auto;
      padding-inline: var(--spacing-sm);
      max-width: calc(1600px + calc(2 * var(--spacing-sm)));
      gap: var(--spacing-xs) var(--spacing-md);
    }
  }

  .partners-label {
    font-size: var(--font-size-xs);
    font-weight: 500;
    letter-spacing: 1.76px;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .partners-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-xs) var(--spacing-lg);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .partners-list li {
    font-family: var(--ff-heading);
    font-size: var(--font-size-md);
    font-weight: 500;
    line-height: 1.2;
    color: var(--text-strong);
  }
</style>
