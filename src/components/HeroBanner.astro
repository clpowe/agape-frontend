---
import { Image } from "astro:assets";

interface Props {
    eyebrow: string;
    title: string;
    body: string;
    image: ImageMetadata;
}

const { eyebrow, title, body, image } = Astro.props;
---

<section>
    <div class="hero-left">
        <div class="content flow">
            <div class="heading-wrapper flow">
                <p class="eyebrow">{eyebrow}</p>
                <h2 class="title">{title}</h2>
            </div>
            <p class="body">
                {body}
            </p>
            <div class="actions">
                <slot name="actions" />
            </div>
            <div>
                <slot />
            </div>
        </div>
    </div>
    <div class="hero-right">
        <Image
            class="main-image"
            src={image}
            alt="A description of my image."
        />
    </div>
</section>

<style>
    section {
        display: grid;
        grid-template-columns: 1fr;
        background-color: var(--clr-off-white);

        .hero-left {
            display: flex;
            max-width: calc(550px + calc(2 * var(--spacing-md)));
            place-self: start;
            padding: var(--spacing-md);
            padding-block: var(--spacing-3xl);
        }

        .hero-right {
            position: relative;
            height: 100%;
            min-height: 600px;
        }

        @media (width > 800px) {
            grid-template-columns: 1fr 1fr;

            .hero-left {
                align-self: center;
                justify-self: end;
                padding: var(--spacing-md);
            }
        }
    }

    .content {
        .heading-wrapper {
            --flow-space: var(--spacing-2xs);
        }
    }

    .eyebrow {
        text-transform: uppercase;
        font-size: var(--font-size-sm);
        letter-spacing: 6%;
        color: var(--clr-red-500);
    }

    .title {
        font-size: var(--font-size-4xl);
        font-weight: 400;

        @media (width > 800px) {
            font-size: var(--font-size-6xl);
        }
    }

    .body {
        color: var(--text-muted);
        max-width: 60ch;
        text-wrap: balance;
    }

    .actions {
        display: flex;
        gap: var(--spacing-md);
    }

    .main-image {
        height: 100%;
        width: 100%;
        object-fit: cover;
    }
</style>
