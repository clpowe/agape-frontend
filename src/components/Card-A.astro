---
import Typography from "@ui/Typography.astro";

interface Props {
  value: string;
  description: string;
}

const { value, description } = Astro.props;
---

<div class="card flow">
  <h3>{value}</h3>
  <Typography variant="body">
    {description}
  </Typography>
</div>

<style>
  .card {
    padding: var(--spacing-2xl);
    background: var(--clr-off-white);
  }
  h3 {
    font-size: var(--font-size-6xl);
    font-weight: 300;
    color: var(--clr-red-500);
  }
</style>
