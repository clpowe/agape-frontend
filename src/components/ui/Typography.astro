---
interface Props {
  tag?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6" | "p" | "blockquote";
  variant: "eyebrow" | "body";
}

const { tag = "p", variant, ...rest } = Astro.props;
const CustomTag = tag;
---

<CustomTag class={variant} {...rest}>
  <slot />
</CustomTag>

<style>
  .eyebrow {
    text-transform: uppercase;
    font-size: var(--font-size-sm);
    letter-spacing: 6%;
    color: var(--text-accent);
  }

  .body {
    color: var(--text-muted);
    max-width: 60ch;
    text-wrap: pretty;
  }
  blockquote {
    border-left: 3px solid var(--text-accent);
    padding-left: var(--spacing-sm);
    font-style: italic;
  }
</style>
