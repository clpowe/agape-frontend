---
interface Props {
  variant: "eyebrow" | "body";
}

const { variant, ...rest } = Astro.props;
---

<p class={variant} {...rest}>
  <slot />
</p>

<style>
  .eyebrow {
    text-transform: uppercase;
    font-size: var(--font-size-sm);
    letter-spacing: 6%;
    color: var(--text-accent);
  }

  .body {
    color: var(--text-muted);
    max-width: 60ch;
    text-wrap: balance;
  }
</style>
