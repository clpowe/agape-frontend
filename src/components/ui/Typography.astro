---
interface Props {
    variant: "eyebrow" | "body";
}

const { variant } = Astro.props;
---

<p class={variant}>
    <slot />
</p>

<style>
    .eyebrow {
        text-transform: uppercase;
        font-size: var(--font-size-sm);
        letter-spacing: 6%;
        color: var(--clr-red-500);
    }

    .body {
        color: var(--text-muted);
        max-width: 60ch;
        text-wrap: balance;
    }
</style>
