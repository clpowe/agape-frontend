---
import Typography from "@ui/Typography.astro";

interface Props {
    eyebrow?: string;
    heading: string;
    body?: string;
    sectionId: string;
}

const { eyebrow, heading, body, sectionId } = Astro.props;

const sectionIdHeading = `${sectionId}-heading`;
---

<div class="flow">
    <Typography variant="eyebrow">{eyebrow}</Typography>
    <h2 id={sectionIdHeading} class="heading">{heading}</h2>
    <Typography variant="body">{body}</Typography>
</div>

<style>
    .heading-wrapper {
        --flow-space: var(--spacing-sm);
    }
    .heading {
        font-size: var(--font-size-4xl);
        max-width: 30ch;
        font-weight: 400;
    }
</style>
