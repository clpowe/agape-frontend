---
import type { Polymorphic } from "astro/types";

type Props<Tag extends "a" | "button" = "a"> = Polymorphic<{ as: Tag }> & {
    variant?:
        | "primary"
        | "accent"
        | "outline"
        | "inverted"
        | "outline-inverted"
        | "ghost"
        | "icon";
    size?: "sm" | "md" | "lg" | "xl";
    popovertarget?: string;
    popovertargetaction?: "toggle" | "show" | "hide";
};

const {
    as: Tag = "a",
    variant = "primary",
    size = "md",
    ...rest
} = Astro.props;
---

<Tag data-custom="btn" class:list={["btn", variant, `size-${size}`]} {...rest}>
    <slot />
</Tag>

<style>
    .btn {
        --_btn-bg: var(--clr-gray-950);
        --_btn-text-clr: var(--clr-white);
        --_btn-ring: var(--clr-gray-950);
        --_btn-pad-block: var(--spacing-xs);
        --_btn-pad-inline: var(--spacing-sm);
        --_btn-font-size: var(--font-size-sm);
        unset: all;
        text-decoration: none;

        display: flex;
        padding: var(--_btn-pad-block) var(--_btn-pad-inline);
        justify-content: center;
        align-items: center;
        line-height: 1;
        gap: 6.5px;
        border: none;
        border-radius: 33px;
        max-width: fit-content;
        cursor: pointer;
        white-space: nowrap;
        font-size: var(--_btn-font-size);
        background: var(--_btn-bg);
        color: var(--_btn-text-clr);

        transition: background 200ms ease-in-out;

        /* ring must appear instantly — never transitioned */
        &:focus-visible {
            outline: 2px solid var(--_btn-ring);
            outline-offset: 3px;
        }

        &:disabled,
        &[aria-disabled="true"] {
            opacity: 0.55;
            cursor: not-allowed;
            pointer-events: none;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .btn {
            transition-duration: 0ms;
        }
    }

    .size-sm {
        --_btn-pad-block: var(--spacing-2xs);
        --_btn-pad-inline: var(--spacing-xs);
        --_btn-font-size: var(--font-size-xs);
        gap: var(--spacing-3xs);
    }

    .size-md {
        --_btn-pad-block: var(--spacing-xs);
        --_btn-pad-inline: var(--spacing-sm);
        --_btn-font-size: var(--font-size-sm);
    }

    .size-lg {
        --_btn-pad-block: var(--spacing-sm);
        --_btn-pad-inline: var(--spacing-lg);
        --_btn-font-size: var(--font-size-md);
        gap: var(--spacing-2xs);
    }

    .size-xl {
        --_btn-pad-block: var(--spacing-md);
        --_btn-pad-inline: var(--spacing-2xl);
        --_btn-font-size: var(--font-size-lg);
        gap: var(--spacing-xs);
    }

    .primary {
        --_btn-bg: var(--clr-gray-950);
        --_btn-text-clr: var(--clr-white);

        &:hover {
            --_btn-bg: var(--clr-gray-500);
        }
    }
    .accent {
        --_btn-bg: var(--clr-red-500);
        --_btn-text-clr: var(--clr-white);

        &:hover {
            --_btn-bg: var(--clr-red-600);
        }

        &:active {
            --_btn-bg: var(--clr-red-400);
        }
    }

    .outline {
        --_btn-bg: transparent;
        --_btn-text-clr: var(--clr-gray-950);
        border: 1px solid var(--clr-gray-950);

        &:hover {
            --_btn-bg: var(--clr-gray-100);
        }

        &:active {
            --_btn-bg: var(--clr-gray-200);
        }
    }

    /* For use on --clr-red-500 / --clr-gray-950 backgrounds */
    .inverted {
        --_btn-bg: var(--clr-white);
        --_btn-text-clr: var(--clr-red-500);
        --_btn-ring: var(--clr-white);

        &:hover {
            --_btn-bg: var(--clr-off-white);
        }

        &:active {
            --_btn-bg: var(--clr-gray-200);
        }
    }

    .outline-inverted {
        --_btn-bg: transparent;
        --_btn-text-clr: var(--clr-white);
        --_btn-ring: var(--clr-white);
        border: 1px solid color-mix(in oklab, var(--clr-white) 45%, transparent);

        &:hover {
            --_btn-bg: color-mix(in oklab, var(--clr-white) 12%, transparent);
            border-color: var(--clr-white);
        }

        &:active {
            --_btn-bg: color-mix(in oklab, var(--clr-white) 22%, transparent);
        }
    }

    .icon {
        padding: var(--spacing-2xs) var(--spacing-2xs);
    }
</style>
